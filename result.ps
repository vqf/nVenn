 
%!PS-Adobe-2.0
 
/scale 1 def
/ury 0  def
/urx 0  def
/lly 900  def
/llx 900  def
 
/showline{     %draws a line from an array of points
topath          %stack: point_array. rgb_color
setrgbcolor
1 setlinejoin
stroke
} def
 
/topath{        %makes a path from an array of points
/tmat exch def  
newpath
tmat 0 get scale mul tmat 1 get scale mul moveto
2 2 tmat length 1 sub
{
dup
tmat exch get
scale mul /x exch def
1 add
tmat exch get
scale mul /y exch def
x y lineto
}for
closepath
}def
 
/showp{                %draws points from an array
/tmat exch def         %stack: point_array. rgb_color
/b exch def
/g exch def
/r exch def
0 2 tmat length 1 sub
{
dup
tmat exch get
scale mul /x exch def
1 add
tmat exch get
scale mul neg /y exch def
newpath
x y 1 0 360 arc
r g b setrgbcolor
stroke
}for
}def
 
/patternshape{
/size 0.5 def
moveto
size 2 div size 2 div rmoveto
0 size neg rlineto
size neg 0 rlineto
0 size rlineto
size 0 rlineto
} def

/colorpattern{
/offsety exch def
/offsetx exch def
/b exch def
/g exch def
/r exch def
/step 8 def
offsetx llx add step urx offsetx add{
/x exch def
 offsety lly add step ury offsety add{
 /y exch def
  newpath
  x y patternshape
  r g b setrgbcolor
  fill
 } for
} for
} def



/minmax{
/tmat exch def

0 2 tmat length 1 sub
{
 dup
 tmat exch get
 scale mul /x exch def
 1 add
 tmat exch get
 scale mul /y exch def
 x urx gt{
 /urx x def
 }if
 x llx lt{
 /llx x def
 }if
 y ury gt{
 /ury y def
 }if
 y lly lt{
 /lly y def
 }if
}for
}def
