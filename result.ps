 tmat exch get
 scale mul /y exch def
 x urx gt{
 /urx x def
 }if
 x llx lt{
 /llx x def
 }if
 y ury gt{
 /ury y def
 }if
 y lly lt{
 /lly y def
 }if
}for
}def
