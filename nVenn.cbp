<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="OpenGL Application" />
		<Option pch_mode="0" />
		<Option compiler="gcc" />
		<Build>
			<Target title="default">
				<Option output="nVennOGL" prefix_auto="0" extension_auto="0" />
				<Option object_output=".globjs" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option projectResourceIncludeDirsRelation="0" />
				<Compiler>
					<Add option="-DGRAPHICS" />
				</Compiler>
			</Target>
			<Target title="plain">
				<Option output="nVenn" prefix_auto="1" extension_auto="1" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Option parameters="venn.txt" />
				<Compiler>
					<Add option="-static-libgcc -static-libstdc++" />
				</Compiler>
				<Linker>
					<Add option="-static" />
					<Add option="-static-libgcc" />
				</Linker>
			</Target>
			<Target title="test">
				<Option output="test" prefix_auto="1" extension_auto="1" />
				<Option type="0" />
				<Option compiler="gcc" />
				<Linker>
					<Add library="opengl32" />
					<Add library="glu32" />
					<Add library="gdi32" />
					<Add library="user32" />
					<Add library="kernel32" />
				</Linker>
			</Target>
			<Target title="towasm">
				<Option output="nVenn_wasm" prefix_auto="1" extension_auto="1" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="test_input">
				<Option output="input" prefix_auto="1" extension_auto="1" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="glut">
				<Option output="nVennGlut" prefix_auto="1" extension_auto="1" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add library="glut" />
					<Add library="GL" />
					<Add library="GLU" />
					<Add library="Xxf86vm" />
				</Linker>
			</Target>
		</Build>
		<VirtualTargets>
			<Add alias="All" targets="default;" />
		</VirtualTargets>
		<Unit filename="bmpfont.h">
			<Option target="default" />
			<Option target="test" />
		</Unit>
		<Unit filename="debug.h">
			<Option target="default" />
			<Option target="plain" />
			<Option target="test" />
		</Unit>
		<Unit filename="elements.h">
			<Option target="default" />
			<Option target="plain" />
			<Option target="towasm" />
			<Option target="test_input" />
		</Unit>
		<Unit filename="glutmain.cpp">
			<Option target="glut" />
		</Unit>
		<Unit filename="graphics.h">
			<Option target="default" />
		</Unit>
		<Unit filename="initogl.h">
			<Option target="test" />
		</Unit>
		<Unit filename="main.cpp">
			<Option target="default" />
			<Option target="plain" />
		</Unit>
		<Unit filename="palettes.h">
			<Option target="default" />
			<Option target="plain" />
			<Option target="test" />
			<Option target="towasm" />
			<Option target="test_input" />
		</Unit>
		<Unit filename="scene.h">
			<Option target="default" />
			<Option target="plain" />
			<Option target="test" />
			<Option target="towasm" />
		</Unit>
		<Unit filename="strFuncts.h">
			<Option target="default" />
			<Option target="plain" />
			<Option target="test" />
			<Option target="towasm" />
			<Option target="test_input" />
		</Unit>
		<Unit filename="test.cpp">
			<Option target="test" />
		</Unit>
		<Unit filename="testinput.cpp">
			<Option target="test_input" />
		</Unit>
		<Unit filename="toGlut.h">
			<Option target="glut" />
		</Unit>
		<Unit filename="topol.h">
			<Option target="default" />
			<Option target="plain" />
			<Option target="test" />
			<Option target="towasm" />
		</Unit>
		<Unit filename="towasm.cpp">
			<Option target="towasm" />
		</Unit>
		<Extensions>
			<DoxyBlocks>
				<comment_style block="0" line="0" />
				<doxyfile_project />
				<doxyfile_build />
				<doxyfile_warnings />
				<doxyfile_output />
				<doxyfile_dot />
				<general />
			</DoxyBlocks>
		</Extensions>
	</Project>
</CodeBlocks_project_file>
