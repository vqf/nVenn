m[rownames(ind@meta.data), "celltype"] <- "BD"
# AP cells
ind <- subset(langer, subset = (Gcg > 4 & Ppy > 2 & Ins1 < 1.5 & Sst < 1.5))
m[rownames(ind@meta.data), "celltype"] <- "AP"
