}
return(gstr)
}
}
knit_print.nVennR = function(x, ...) {
g <- getVennSvg()
s <- subsuid('[\\.\\#](.+?)\\s*\\{', g)
s <- subsuid('bl\\d+', s)
knitr::asis_output(s)
}
