m[rownames(ind@meta.data), "celltype"] <- "Beta"
# Alpha cells
ind <- subset(langer, subset = (Gcg > 5.5 & Ppy < 2.5 & Ins1 < 5.5))
m[rownames(ind@meta.data), "celltype"] <- "Alpha"
# Delta cells
